+u_int8_t radiotapFillRadiotapClone(struct ADAPTER *prAdapter,
+				   struct SW_RFB *prSwRfb,
+				   void *pvMonitorDev)
+{
+	struct SW_RFB rMonitorRfb;
+	void *pvPacket;
+	uint8_t *pucRecvBuff;
+	uint32_t u4CopyLen;
+
+	if (!prAdapter || !prSwRfb || !prSwRfb->pvPacket || !pvMonitorDev)
+		return FALSE;
+
+	u4CopyLen = ALIGN_4(prSwRfb->u2RxByteCount +
+		HIF_RX_HW_APPENDED_LEN);
+	if (u4CopyLen > CFG_RX_MAX_PKT_SIZE)
+		return FALSE;
+	pvPacket = kalPacketAlloc(prAdapter->prGlueInfo, u4CopyLen,
+		FALSE, &pucRecvBuff);
+	if (!pvPacket)
+		return FALSE;
+	kalMemCopy(pucRecvBuff, prSwRfb->pucRecvBuff, u4CopyLen);
+
+	rMonitorRfb = *prSwRfb;
+	rMonitorRfb.pvPacket = pvPacket;
+	rMonitorRfb.pucRecvBuff = pucRecvBuff;
+	rMonitorRfb.prRxStatus = rMonitorRfb.pucRecvBuff;
+	rMonitorRfb.prRadiotapInfo = NULL;
+	return radiotapFillRadiotapInternal(prAdapter, &rMonitorRfb,
+		pvMonitorDev, FALSE);
 }
 #endif
