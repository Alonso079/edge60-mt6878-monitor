diff --git a/os/linux/gl_kal.c b/os/linux/gl_kal.c
index bbdc1c2..1e0c682 100644
--- a/os/linux/gl_kal.c
+++ b/os/linux/gl_kal.c
@@ -3735,10 +3735,32 @@ kalHardStartXmit(struct sk_buff *prOrgSkb,
 
 	if (prBssInfo->eNetworkType == NETWORK_TYPE_AIS &&
 		prBssInfo->eConnectionState != MEDIA_STATE_CONNECTED) {
+#ifdef CFG_SUPPORT_SNIFFER_RADIOTAP
+		/*
+		 * TX-INJECT BYPASS: When the radio is in monitor/sniffer mode
+		 * the BSS is intentionally disconnected (no AP association).
+		 * Allow raw 802.11 frames from userspace to pass through so that
+		 * standard injection tools (aireplay-ng, mdk4, scapy, etc.) can
+		 * work over the AF_PACKET / SOCK_RAW interface.
+		 *
+		 * Safety gate: we only bypass when the driver is actually in
+		 * monitor mode. Normal AP/STA traffic still goes through the
+		 * regular disconnection check.
+		 */
+		if (!prGlueInfo->fgIsEnableMon) {
+			DBGLOG(INIT, INFO,
+				"ais status is not connected, skip this frame\n");
+			dev_kfree_skb(prOrgSkb);
+			return WLAN_STATUS_NOT_ACCEPTED;
+		}
+		DBGLOG_LIMITED(INIT, WARN,
+			"[TX-INJECT] monitor mode: bypassing AIS conn check\n");
+#else
 		DBGLOG(INIT, INFO,
 			"ais status is not connected, skip this frame\n");
 		dev_kfree_skb(prOrgSkb);
 		return WLAN_STATUS_NOT_ACCEPTED;
+#endif
 	}
 
 	if (prGlueInfo->prAdapter->fgIsEnableLpdvt) {
@@ -3812,6 +3834,97 @@ kalHardStartXmit(struct sk_buff *prOrgSkb,
 	GLUE_SET_PKT_BSS_IDX(prSkb, ucBssIndex);
 
 	/* Parsing frame info */
+#ifdef CFG_SUPPORT_SNIFFER_RADIOTAP
+	if (prGlueInfo->fgIsEnableMon) {
+		uint8_t *pucFrame = prSkb->data;
+		uint16_t u2RadiotapLen = 0;
+		uint16_t u2FrameCtrl;
+		uint8_t ucMacHeaderLen;
+		uint32_t u4SysTime;
+		u_int8_t fgHasRadiotap = FALSE;
+		u_int8_t fgValid80211 = TRUE;
+
+		/*
+		 * Linux monitor interfaces use ARPHRD_IEEE80211_RADIOTAP.  Strip the
+		 * userspace metadata before DMA; the firmware must receive the native
+		 * IEEE 802.11 MPDU starting at Frame Control.  Keep accepting a bare
+		 * MPDU for the small native diagnostic tool.
+		 */
+		if (prSkb->len >= 8 && pucFrame[0] == 0 && pucFrame[1] == 0) {
+			u2RadiotapLen = (uint16_t)pucFrame[2] |
+				((uint16_t)pucFrame[3] << 8);
+			if (u2RadiotapLen >= 8 && u2RadiotapLen <= prSkb->len) {
+				skb_pull(prSkb, u2RadiotapLen);
+				pucFrame = prSkb->data;
+				fgHasRadiotap = TRUE;
+			}
+		}
+
+		if (prSkb->len < 10) {
+			fgValid80211 = FALSE;
+			u2FrameCtrl = 0;
+		} else {
+			u2FrameCtrl = (uint16_t)pucFrame[0] |
+				((uint16_t)pucFrame[1] << 8);
+			/* Protocol version must be zero; type 3 is reserved. */
+			if ((u2FrameCtrl & BITS(0, 1)) != 0 ||
+			    (u2FrameCtrl & MASK_FC_TYPE) == MASK_FC_TYPE)
+				fgValid80211 = FALSE;
+		}
+
+		ucMacHeaderLen = WLAN_MAC_MGMT_HEADER_LEN;
+		if (fgValid80211) {
+			switch (u2FrameCtrl & MASK_FC_TYPE) {
+			case MAC_FRAME_TYPE_MGT:
+				ucMacHeaderLen = WLAN_MAC_MGMT_HEADER_LEN;
+				break;
+			case MAC_FRAME_TYPE_CTRL:
+				/* ACK and CTS only contain RA; other control frames
+				 * have at least RA and TA.
+				 */
+				if ((u2FrameCtrl & MASK_FC_SUBTYPE) == 0x00c0 ||
+				    (u2FrameCtrl & MASK_FC_SUBTYPE) == 0x00d0)
+					ucMacHeaderLen = 10;
+				else
+					ucMacHeaderLen = 16;
+				break;
+			case MAC_FRAME_TYPE_DATA:
+				ucMacHeaderLen = WLAN_MAC_MGMT_HEADER_LEN;
+				if ((u2FrameCtrl & MASK_TO_DS_FROM_DS) ==
+				    MASK_TO_DS_FROM_DS)
+					ucMacHeaderLen += 6;
+				if (u2FrameCtrl & MASK_FC_SUBTYPE_QOS_DATA) {
+					ucMacHeaderLen += 2;
+					if (u2FrameCtrl & MASK_FC_ORDER)
+						ucMacHeaderLen += 4;
+				}
+				break;
+			default:
+				fgValid80211 = FALSE;
+				break;
+			}
+		}
+
+		if (!fgValid80211 || prSkb->len < ucMacHeaderLen ||
+		    prSkb->len > 0xffffU) {
+			DBGLOG(TX, WARN,
+				"[TX-INJECT] reject malformed frame len=%u rtap=%u\n",
+				prSkb->len, u2RadiotapLen);
+			dev_kfree_skb(prSkb);
+			return WLAN_STATUS_INVALID_PACKET;
+		}
+
+		GLUE_SET_PKT_FLAG(prSkb, ENUM_PKT_802_11);
+		GLUE_SET_PKT_HEADER_LEN(prSkb, ucMacHeaderLen);
+		GLUE_SET_PKT_FRAME_LEN(prSkb, (uint16_t)prSkb->len);
+		u4SysTime = (OS_SYSTIME)kalGetTimeTick();
+		GLUE_SET_PKT_ARRIVAL_TIME(prSkb, u4SysTime);
+		GLUE_SET_PKT_TID(prSkb, 0);
+		DBGLOG_LIMITED(TX, WARN,
+			"[TX-INJECT] raw 802.11 len=%u hdr=%u rtap=%u\n",
+			prSkb->len, ucMacHeaderLen, fgHasRadiotap);
+	} else
+#endif
 	if (!wlanProcessTxFrame(prGlueInfo->prAdapter,
 				(void *) prSkb)) {
 		/* Cannot extract packet */
